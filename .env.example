# Copy this to .env and fill in your values
DB_PASSWORD=changeme_dev
SECRET_KEY=change_this_to_a_random_32_char_secret_for_prod
STORAGE_ROOT=./storage
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://sih_app:changeme_dev@localhost:5432/sih26261

# OCR fast-fail threshold (0.0 to 1.0)
OCR_FAST_FAIL_THRESHOLD=0.60

# LLM for RAG proposals (leave blank to disable; use: gemini, groq, claude)
LLM_PROVIDER=
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# ClamAV (set to true if clamd is running)
CLAMAV_ENABLED=false

# Set true to disable all network calls
OFFLINE_ONLY=false
